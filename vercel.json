{
    "version": 2,
    "builds": [
        {
            "src": "src/app.py",
            "use": "@vercel/python",
            "config": {
                "pythonVersion": "3.11"
            }
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "public"
            }
        }
    ],
    "routes": [
        {
            "src": "^/api/.*",
            "dest": "src/app.py"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "^(?!/api).*",
            "dest": "/index.html"
        }
    ]
}